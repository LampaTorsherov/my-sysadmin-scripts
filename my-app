server {
  listen 80;
  server_name my-app-redir;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  server_name my-app;
  
  ssl_certificate /etc/ssl/certs/my-app.crt;
  ssl_certificate_key /etc/ssl/private/my-app.key;

  location / {
    proxy_pass http://localhost:8080;
  }
}
